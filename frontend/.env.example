# Only non-secret configuration may live here; everything VITE_* is compiled into the public bundle.
# Base URL of the local demo API. Keep the default same-origin path: Vite proxies /api to 127.0.0.1:8765, and the
# demo API sends no CORS headers, so a cross-origin URL (http://127.0.0.1:8765/...) would be blocked by the browser.
VITE_API_BASE=/api/v1
